# =============================================================
# SERVER ENVIRONMENT VARIABLES — TEMPLATE
# Copy this file to .env and fill in the values.
# Never commit your actual .env file to version control.
# =============================================================

# ─── Server ──────────────────────────────────────────────────
PORT=5005
NODE_ENV=development

# ─── MongoDB Atlas ───────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/it-management-system?appName=Cluster0

# ─── Client CORS ─────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ─── JWT ─────────────────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-secret-string
JWT_EXPIRE=7d

# ─── Super Admin Bootstrap (server-only) ─────────────────────
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=replace-with-secure-password

# ─── Application ─────────────────────────────────────────────
LOG_LEVEL=info

# =============================================================
# SMTP — Email Delivery for Password-Reset OTP
# =============================================================
#
# PROVIDER-INDEPENDENT SMTP SETTINGS
# Works with Gmail, Outlook, Zoho, Mailgun SMTP, SendGrid SMTP, etc.
#
# ── Gmail (recommended for development) ───────────────────────
#   1. Enable 2-Step Verification on your Google Account.
#   2. Go to: Google Account → Security → App Passwords
#   3. Generate an App Password for "Mail" / "Other (Custom name)"
#   4. Use that 16-character App Password as SMTP_PASS below.
#      (Do NOT use your regular Gmail password.)
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=Aasha SM Tech CRM <your-email@gmail.com>
#
# ── Outlook / Hotmail ─────────────────────────────────────────
# SMTP_HOST=smtp-mail.outlook.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@outlook.com
# SMTP_PASS=your-password
# SMTP_FROM=Aasha SM Tech CRM <your-email@outlook.com>
#
# ── Zoho Mail ─────────────────────────────────────────────────
# SMTP_HOST=smtp.zoho.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@zoho.com
# SMTP_PASS=your-password
# SMTP_FROM=Aasha SM Tech CRM <your-email@zoho.com>
#
# ── SendGrid SMTP ─────────────────────────────────────────────
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=your-sendgrid-api-key
# SMTP_FROM=Aasha SM Tech CRM <noreply@yourdomain.com>
# =============================================================
